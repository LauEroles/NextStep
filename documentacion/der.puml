' Relaciones de Postulaciones y Etapas
users ||--o{ applications : "se postula (applicant)"
job_offers ||--o{ applications : "recibe"
stages ||--o{ applications : "marca el estado actual de"

' Relaciones de Feedback
applications ||--o{ feedbacks : "tiene"
stages ||--o{ feedbacks : "identifica el momento del"
